{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/chat-stream",
      "destination": "/api/chat-stream"
    },
    {
      "source": "/api/tts",
      "destination": "/api/tts"
    },
    {
      "source": "/api/tts-stream",
      "destination": "/api/tts-stream"
    },
    {
      "source": "/api/auto-improve",
      "destination": "/api/auto-improve"
    },
    {
      "source": "/api/upload",
      "destination": "/api/upload"
    },
    {
      "source": "/api/metrics",
      "destination": "/api/metrics"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat-stream.ts": {
      "maxDuration": 30
    },
    "api/chat.ts": {
      "maxDuration": 30
    },
    "api/tts.ts": {
      "maxDuration": 30
    },
    "api/tts-stream.ts": {
      "maxDuration": 30
    },
    "api/auto-improve.ts": {
      "maxDuration": 180
    },
    "api/upload.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/metrics.ts": {
      "maxDuration": 10
    }
  }
}
