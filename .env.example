# ── J.A.R.V.I.S. Environment Configuration ──────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# LLM APIs (pelo menos um é obrigatório)
# Groq (Llama 3.3 70B, Gemma 2 9B, Llama 3.1 8B) — Gratuito e rápido
GROQ_API_KEY=gsk_...

# OpenAI (GPT-4o, GPT-4o-mini) — Premium
OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5 Sonnet) — Premium, excelente para código
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini 2.0 Flash) — Criativo, multimodal
GEMINI_API_KEY=AIza...

# Modelo padrão (opcional, default: llama-3.3-70b-versatile)
DEFAULT_MODEL=llama-3.3-70b-versatile

# Banco de Dados (SQLite local por padrão)
DATABASE_URL=file:./jarvis.db

# Supabase (opcional — para memória semântica vetorial)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ElevenLabs (opcional — para voz realista)
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# Home Assistant (opcional — para automação residencial)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=...

# JWT Secret (gere um aleatório)
JWT_SECRET=jarvis-super-secret-key-change-me

# GitHub (para auto-melhoria)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=shadowgames12200/ia-estilo-tonystark

# ── Multi-Modal ──────────────────────────────────

# Tavily (pesquisa na web)
TAVILY_API_KEY=...

# OpenAI (para DALL-E 3 e visão) — já configurado acima
