# Jarvis — configuração local segura
PORT=3000
HOST=127.0.0.1

# O modelo de respostas e ferramentas será exclusivamente local.
LOCAL_ONLY_MODE=true
HYBRID_MODE_ENABLED=false
LOCAL_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_OPENAI_MODEL=
LOCAL_FAST_MODEL=qwen/qwen3-4b-2507
LOCAL_AGENT_MODEL=qwen-3-8b-instruct
LOCAL_VISION_MODEL=qwen/qwen3-vl-4b
# Opcional: use um modelo maior carregado no LM Studio para revisão independente.
LOCAL_REVIEW_MODEL=

# Para conversa natural, mantenha o modelo rápido sem thinking; use o agente
# somente para código, arquivos, planejamento e tarefas complexas.
LOCAL_CONTEXT_TOKENS=8192
LOCAL_PLANNER_MODEL=qwen-3-8b-instruct
JARVIS_ADVANCED_MEMORY_ROOT=~/.jarvis-advanced-memory

# Daemon local de voz: microfone, wake word, VAD, Whisper e WebSocket.
VITE_JARVIS_LOCAL_DAEMON=true
VITE_JARVIS_VOICE_WS=ws://127.0.0.1:8765
# Voz local opcional. Use piper para evitar TTS do navegador e APIs pagas.
# No Windows, use caminhos completos se os executáveis não estiverem no PATH.
PIPER_BIN=piper
PIPER_MODEL=
WHISPER_BIN=whisper-cli
WHISPER_MODEL=
WHISPER_LANGUAGE=pt
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE=int8
JARVIS_WAKE_WORD_ENABLED=true
JARVIS_WAKE_THRESHOLD=0.55
JARVIS_END_SILENCE_MS=650
FFMPEG_BIN=ffmpeg

# Diretórios autorizados para manutenção de projetos.
JARVIS_PROJECT_ROOT=
JARVIS_ALLOWED_PROJECTS=
JARVIS_WORKSPACE_DIR=~/.jarvis-projects
JARVIS_UPLOAD_DIR=uploads

# Entrega verificável de arquivos e planos retomáveis.
# Sem outputPath explícito, os artefatos vão para esta pasta.
JARVIS_ARTIFACT_ROOT=~/.jarvis-artifacts
JARVIS_ARTIFACT_ALLOWED_ROOTS=
# Use true somente se quiser permitir caminhos absolutos informados pelo usuário.
JARVIS_ALLOW_EXPLICIT_OUTPUT_PATHS=false
JARVIS_WORKFLOW_FILE=~/.jarvis-projects/workflows.json
JARVIS_SAFE_COMMAND_TIMEOUT_MS=120000
JARVIS_KNOWLEDGE_ROOT=~/.jarvis-knowledge
JARVIS_PROJECT_MEMORY_ROOT=~/.jarvis-projects/profiles
JARVIS_CHROME_CDP_URL=http://127.0.0.1:9222
JARVIS_BROWSER_PERSIST_PROFILE=false
JARVIS_BROWSER_HEADLESS=false
JARVIS_REQUIRE_VERIFICATION=true
# Segredo obrigatório para assinar sessões; gere um valor aleatório longo.
JWT_SECRET=
# Em modo público, o chat e o TTS exigem sessão autenticada.
JARVIS_MAX_JSON_BODY=2mb
JARVIS_MAX_MESSAGE_CHARS=12000
JARVIS_MAX_TTS_CHARS=4000

# Arquitetura híbrida recomendada para Windows 11 + WSL2.
# O processo principal deve rodar no Windows para controlar janelas, mouse,
# teclado, microfone e gerar .exe. O WSL fica para código, testes e Docker.
JARVIS_RUNTIME_ROLE=windows-controller
JARVIS_WSL_ENABLED=true
JARVIS_WSL_DISTRO=Ubuntu-24.04
JARVIS_WSL_WORKSPACE=\\wsl.localhost\\Ubuntu-24.04\\home\\SEU_USUARIO\\jarvis
JARVIS_DOCKER_ENGINE=docker-desktop-wsl2

# Limites do executor Docker.
JARVIS_EXECUTOR_CPUS=2
JARVIS_EXECUTOR_MEMORY=2g
# O sandbox falha fechado: Docker indisponível bloqueia a execução de código.

# Integrações externas opcionais; não são necessárias para o modelo local.
# GITHUB_TOKEN=
# TAVILY_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
